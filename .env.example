# Copy to .env and fill in. Never commit .env.

# Supabase (Postgres, auth, storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI providers
GEMINI_API_KEY=
SARVAM_API_KEY=

# Embeddings: "local" (small model on this machine, no key) or "gemini" (needs GEMINI_API_KEY).
# Switching provider means re-processing uploaded documents, since vectors from
# different models cannot be compared.
EMBEDDING_PROVIDER=local
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Vector store
CHROMA_PATH=./chroma

# Where the web app runs, allowed to call the API
WEB_ORIGIN=http://localhost:3000
